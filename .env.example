# Plantilla de variables de entorno de ToM Server.
# Copia este archivo a .env y completa los valores reales:
#   cp .env.example .env
# Todas tienen default en el código, así que solo define las que necesites
# sobrescribir. Los secretos de Cloudinary SÍ conviene definirlos aquí.

# Puertos
PORT=3000
HTTPS_PORT=3443

# MongoDB
MONGODB_URI=mongodb://0.0.0.0:27017/beer_control

# Carpeta de datos (local.json / .emergencyCard.json)
DATA_FOLDER=/home/tom/Documents/Beer_control/data

# Sockets externos
CLOUD_SOCKET_URL=https://chikilla-real-time-taps.herokuapp.com/
SELFPOUR_SOCKET_URL=http://192.168.1.79

# Cloudinary (rotar el secret y no compartirlo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
